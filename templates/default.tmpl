{{- if and .CanonicalLink (eq .URL .CanonicalLink) -}}
{{bold "URL (canonical):"}} {{cyan .URL}}
{{- else -}}
{{bold "URL:"}} {{cyan .URL}}
{{- end}}
{{bold "Title:"}} {{green .Title}}
{{- if .OGDescription}}
{{bold "Description:"}} {{.OGDescription}}
{{- else if .TwitterDescription}}
{{bold "Description:"}} {{.TwitterDescription}}
{{- end}}
{{- if .CoverImages}}
{{bold "Cover Images:"}}
{{- range .CoverImages}}
  - {{yellow .}}
{{- end}}
{{- end}}
