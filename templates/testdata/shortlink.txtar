-- description --
Short Link is parsed and displayed
-- input.json --
{
  "URL": "https://example.com/some-page?utm_source=test",
  "Title": "Test Title",
  "ShortLink": "https://example.com/sp"
}
-- expected.txt --
URL: https://example.com/some-page?utm_source=test
Title: Test Title
HTML Short Link: https://example.com/sp
-- expected_default.txt --
URL: https://example.com/some-page?utm_source=test
Title: Test Title
-- expected_json.txt --
{
  "URL": "https://example.com/some-page?utm_source=test",
  "Title": "Test Title",
  "JSONLDUploadDateParsed": "0001-01-01T00:00:00Z",
  "ShortLink": "https://example.com/sp"
}
-- expected_discord.txt --

URL: https://example.com/some-page?utm_source=test
Title: Test Title
-- expected_jsonld.txt --

URL: https://example.com/some-page?utm_source=test
-- expected_opengraph.txt --

URL: https://example.com/some-page?utm_source=test
-- expected_twitter.txt --

URL: https://example.com/some-page?utm_source=test
