-- description --
Tests that Alternate Link is rendered correctly in the output.
-- input.json --
{
  "URL": "https://example.com/desktop",
  "Title": "Example",
  "AlternateLinks": [
    {
      "URL": "https://m.example.com/mobile",
      "Media": "handheld"
    }
  ]
}
-- expected.txt --
URL: https://example.com/desktop
Title: Example
HTML Alternate Link: https://m.example.com/mobile (handheld)
-- expected_default.txt --
URL: https://example.com/desktop
Title: Example
-- expected_json.txt --
{
  "URL": "https://example.com/desktop",
  "Title": "Example",
  "JSONLDUploadDateParsed": "0001-01-01T00:00:00Z",
  "AlternateLinks": [
    {
      "URL": "https://m.example.com/mobile",
      "Media": "handheld"
    }
  ]
}
-- expected_discord.txt --

URL: https://example.com/desktop
Title: Example
-- expected_jsonld.txt --
{
  "URL": "https://example.com/desktop",
  "Title": "Example",
  "JSONLDUploadDateParsed": "0001-01-01T00:00:00Z",
  "AlternateLinks": [
    {
      "URL": "https://m.example.com/mobile",
      "Media": "handheld"
    }
  ]
}
-- expected_opengraph.txt --

URL: https://example.com/desktop
-- expected_twitter.txt --

URL: https://example.com/desktop
