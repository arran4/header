-- description --
Fields from different sources have the same values and should be grouped
-- input.json --
{
  "URL": "https://example.com",
  "Title": "Test Title",
  "OGTitle": "Same Title",
  "OGType": "website",
  "OGDescription": "Same description",
  "TwitterCard": "website",
  "TwitterTitle": "Same Title",
  "TwitterDescription": "Same description",
  "JSONLDType": "website",
  "JSONLDName": "Same Title"
}
-- expected.txt --
URL: https://example.com
Title: Test Title
OpenGraph, Twitter and JSON-LD Type/Card: website
OpenGraph and Twitter Title: Same Title
OpenGraph and Twitter Description: Same description
JSON-LD Name: Same Title
