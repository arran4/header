-- description --
Canonical Link matches URL
-- input.json --
{
  "URL": "https://example.com",
  "Title": "Test Title",
  "CanonicalLink": "https://example.com"
}
-- expected.txt --
URL (canonical): https://example.com
Title: Test Title
-- expected_default.txt --
URL (canonical): https://example.com
Title: Test Title
-- expected_plain.txt --
URL (canonical): https://example.com
Title: Test Title
-- expected_json.txt --
{
  "URL": "https://example.com",
  "Title": "Test Title",
  "JSONLDUploadDateParsed": "0001-01-01T00:00:00Z",
  "CanonicalLink": "https://example.com"
}
-- expected_markdown.txt --
# Test Title

**URL:** https://example.com
