{{- if and .CanonicalLink (eq .URL .CanonicalLink) -}}
{{bold "URL (canonical):"}} {{cyan .URL}}
{{- else -}}
{{bold "URL:"}} {{cyan .URL}}
{{- end}}
{{bold "Title:"}} {{green .Title}}
{{- range .GroupedProperties}}
{{bold .Label}}{{bold ":"}} {{.Value}}
{{- end}}
{{- if .CoverImages}}
{{bold "Cover Images:"}}
{{- range .CoverImages}}
  - {{yellow .}}
{{- end}}
{{- end}}
