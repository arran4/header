Extract OpenGraph with alternate link using max-width media query
-- example.html --
<html>
<head>
	<title>Test Title</title>
	<link rel="alternate" media="only screen and (max-width: 640px)" href="https://m.youtube.com/watch?v=jNQXAC9IVRw">
</head>
<body></body>
</html>
-- expected.json --
{
  "URL": "",
  "Title": "Test Title",
  "Keywords": "",
  "OGTitle": "",
  "OGType": "",
  "OGImage": "",
  "OGImageSecureURL": "",
