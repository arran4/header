test: cli

exec header extract --style all_fields_plain $TEST_SERVER_URL/example
stdout 'URL: http'
stdout 'Title: Example Page'
stdout 'OpenGraph Type: website'
stdout 'Twitter Card: summary'
stdout 'HTML Canonical Link: https://example.com/canonical-url'
stdout 'HTML Icon: https://example.com/favicon.ico'
stdout 'HTML Icon: https://example.com/favicon_32x32.png \(32x32\)'
stdout 'HTML Feed Link: https://example.com/feed.xml \("RSS Feed", application/rss\+xml\)'
stdout 'JSON-LD Type: WebPage'

exec header extract --style all_fields $TEST_SERVER_URL/example
stdout 'URL:'
stdout 'Title:'
stdout 'HTML Canonical Link:'
stdout 'https://example.com/canonical-url'
stdout 'HTML Feed Link: https://example.com/feed.xml \("RSS Feed", application/rss\+xml\)'
stdout 'HTML Icon: https://example.com/favicon.ico'
stdout 'HTML Icon: https://example.com/favicon_32x32.png \(32x32\)'

exec header extract --test --style all_fields_plain $TEST_SERVER_URL/missing
stdout '--- Diagnostics ---'
stdout 'Missing Twitter Card Data'

exec header extract --show-image --style all_fields_plain $TEST_SERVER_URL/example
stdout 'Displaying image'

exec header extract --style all_fields_plain $TEST_SERVER_URL/issue
stdout 'URL \(canonical\):'
stdout 'Title: arran4 - Overview'
stdout 'OpenGraph Title: arran4 - Overview'
stdout 'OpenGraph Type: profile'

exec header extract --style all_fields $TEST_SERVER_URL/issue
stdout 'URL \(canonical\):'
stdout 'Title:'
stdout 'OpenGraph Title:'

exec header extract --style all_fields_plain $TEST_SERVER_URL/media
stdout 'URL: http'
stdout 'Title: Media Title'
stdout 'HTML Alternate Link: https://m.example.com/mobile \(only screen and \(max-width: 640px\)\)'

exec header extract --style all_fields_plain $TEST_SERVER_URL/instagram
stdout 'AppLinks iOS Name: Instagram'
stdout 'AppLinks iOS App Store ID: 389801252'
stdout 'Instagram Owner User ID: 25048339'
stdout 'HTML Application Title: Instagram'
stdout 'HTML Theme Color: #ffffff'
