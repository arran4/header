exec header lint-rule-lists list
stdout 'Available Lint Lists:'
stdout 'recommended: \[consistency, html, images, opengraph, twitter, cors, cloudflare\]'

exec header lint-rule-lists list-rules
stdout 'Available Lint Rules:'
stdout 'consistency: Metadata Consistency Checks'

exec header lint-rules list
stdout 'Available Lint Rules:'
stdout 'consistency: Metadata Consistency Checks'
