test: style listing, export and custom style loading

exec header styles
stdout 'Available Styles:'
stdout 'all_fields'
stdout 'default'
stdout 'html'
stdout 'quick'

exec header style list
stdout 'Available Styles:'
stdout 'all_fields'
stdout 'default'
stdout 'html'
stdout 'quick'

exec header style export all_fields
stdout 'URL:'

exec header style export html
stdout '<head>'

exec header style export quick
stdout 'URL:'

exec header style export --out exported.tmpl all_fields
! exec header style export --out exported.tmpl all_fields
stderr 'already exists'

! exec header style export --out existing_dir all_fields
stderr 'destination is a directory'

# Force overwrite replaces existing file safely
exec header style export --force --out exported.tmpl quick
exec header extract --style-file exported.tmpl $TEST_SERVER_URL/example
stdout 'Example Page'
! stdout 'OpenGraph Type:'

exec header style export --force --out exported.tmpl all_fields

exec header extract --style-file exported.tmpl $TEST_SERVER_URL/example
stdout 'Example Page'
stdout 'OpenGraph Type:'

exec header extract --style html $TEST_SERVER_URL/example
stdout '<head>'
stdout '<title>Example Page</title>'
stdout '</head>'

exec header extract --style quick $TEST_SERVER_URL/example
stdout 'Example Page'
stdout 'URL:'

! exec header extract --style json --style-file exported.tmpl $TEST_SERVER_URL/example
stderr 'cannot specify both --style and --style-file'

! exec header extract --style not-a-style $TEST_SERVER_URL/example
stderr 'available styles:'
-- existing_dir/keep.txt --
